.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.vote-detail {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.vote-header {
  display: flex;
  align-items: center;
  margin-bottom: 30rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  color: white;
  font-size: 32rpx;
  font-weight: 600;
}

.creator-info {
  flex: 1;
}

.creator-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.create-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag.active {
  background: #ecfdf5;
  color: #059669;
}

.status-tag.ended {
  background: #fef3c7;
  color: #d97706;
}

.vote-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 16rpx;
}

.vote-desc {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 30rpx;
}

.vote-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666;
}

.meta-icon {
  margin-right: 8rpx;
}

.options-section {
  margin-bottom: 30rpx;
}

.option-card {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.option-card:active {
  background: #f0f0f0;
}

.option-content {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.option-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 4rpx solid #ddd;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.option-radio.selected {
  border-color: #7c3aed;
}

.radio-inner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: transparent;
}

.option-radio.selected .radio-inner {
  background: #7c3aed;
}

.option-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.option-stats {
  display: flex;
  align-items: center;
  padding-left: 60rpx;
}

.progress-bar {
  flex: 1;
  height: 12rpx;
  background: #e5e5e5;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.percentage {
  font-size: 26rpx;
  color: #7c3aed;
  font-weight: 600;
  margin-left: 16rpx;
  min-width: 80rpx;
  text-align: right;
}

.vote-count {
  font-size: 24rpx;
  color: #999;
  margin-left: 8rpx;
}

.vote-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
  border-radius: 48rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}

.voted-hint {
  padding: 24rpx;
  background: #ecfdf5;
  border-radius: 16rpx;
  text-align: center;
  color: #059669;
  font-size: 28rpx;
  margin-bottom: 30rpx;
}

.share-section {
  margin-top: 30rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  color: #666;
  font-size: 28rpx;
}

.share-icon {
  margin-right: 12rpx;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 40rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-state text:last-child {
  font-size: 28rpx;
  color: #999;
}

/* ============ 评论样式 ============ */
.comment-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.comment-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.comment-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.comment-count {
  font-size: 24rpx;
  color: #999;
}

.comment-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #ccc;
  font-size: 26rpx;
}

.comment-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
  position: relative;
}

.comment-item:last-child {
  border-bottom: none;
}

.comment-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.comment-avatar-text {
  color: white;
  font-size: 26rpx;
  font-weight: 600;
}

.comment-avatar-img {
  width: 100%;
  height: 100%;
}

.comment-body {
  flex: 1;
  min-width: 0;
}

.comment-meta-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.comment-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.comment-time {
  font-size: 22rpx;
  color: #999;
}

.comment-content {
  font-size: 28rpx;
  color: #444;
  line-height: 1.6;
  word-break: break-all;
}

.comment-delete {
  font-size: 24rpx;
  color: #ef4444;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
  margin-left: 8rpx;
}

.comment-loading,
.comment-more {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

/* 底部评论输入栏 */
.comment-input-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: white;
  padding: 16rpx 24rpx;
  display: flex;
  align-items: center;
  border-top: 2rpx solid #eee;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.comment-input-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.comment-input-avatar-text {
  color: white;
  font-size: 26rpx;
  font-weight: 600;
}

/* ============ 参与者列表样式 ============ */
.voters-section {
  margin-top: 30rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}

.voters-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.voters-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.voters-count {
  font-size: 24rpx;
  color: #999;
}

.voters-empty {
  text-align: center;
  padding: 60rpx 20rpx;
  color: #ccc;
  font-size: 26rpx;
}

.voter-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.voter-item:last-child {
  border-bottom: none;
}

.voter-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.voter-avatar-text {
  color: white;
  font-size: 26rpx;
  font-weight: 600;
}

.voter-avatar-img {
  width: 100%;
  height: 100%;
}

.voter-info {
  flex: 1;
  min-width: 0;
}

.voter-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
  display: block;
}

.voter-time {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
  display: block;
}

.voter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
  max-width: 200rpx;
}

.voter-option {
  background: #f3f0ff;
  color: #7c3aed;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-weight: 500;
}

.voters-loading {
  text-align: center;
  padding: 24rpx 0;
  font-size: 24rpx;
  color: #999;
}

.comment-input {
  flex: 1;
  background: #f5f5f5;
  border-radius: 32rpx;
  padding: 16rpx 24rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.comment-send {
  background: #ddd;
  color: white;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 32rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.comment-send.active {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
}
