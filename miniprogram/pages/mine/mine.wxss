/* pages/mine/mine.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
}

.profile-card {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  color: white;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.25);
  margin-bottom: 24rpx;
}

.profile-main {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-text {
  color: white;
  font-size: 48rpx;
  font-weight: 700;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.profile-openid {
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 6rpx;
}

.profile-tip {
  font-size: 24rpx;
  opacity: 0.7;
}

.tab-bar {
  display: flex;
  background: white;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #666;
  border-radius: 12rpx;
  transition: all 0.2s;
}

.tab-item.active {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
  font-weight: 600;
}

.list {
  display: block;
}

.vote-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.vote-title-line {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.vote-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  margin-right: 16rpx;
}

.status-tag {
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-tag.active {
  background: #ecfdf5;
  color: #059669;
}

.status-tag.ended {
  background: #fef3c7;
  color: #d97706;
}

.vote-meta-line {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
  gap: 8rpx;
}

.meta-comment {
  color: #7c3aed;
  margin-left: auto;
}

.empty {
  text-align: center;
  padding: 120rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  display: block;
}

.loading-more {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 24rpx;
}

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.modal-body {
  width: 80%;
  max-width: 600rpx;
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-row {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  width: 100%;
  box-sizing: border-box;
}

.form-tip {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
}

.btn-cancel,
.btn-save {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-cancel {
  background: #f5f5f5;
  color: #666;
}

.btn-save {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
}
