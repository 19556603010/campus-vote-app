.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.user-card {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  padding: 60rpx 40rpx;
}

.user-info {
  display: flex;
  align-items: center;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  margin-right: 24rpx;
}

.info {
  flex: 1;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  display: block;
}

.tip {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.logout-btn {
  padding: 12rpx 32rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: white;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
}

.login-icon {
  font-size: 48rpx;
  margin-right: 16rpx;
}

.login-text {
  font-size: 32rpx;
  color: white;
}

.stats-card {
  display: flex;
  margin: -40rpx 20rpx 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #7c3aed;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: #f0f0f0;
}

.section {
  background: white;
  margin: 20rpx;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.create-link {
  font-size: 26rpx;
  color: #7c3aed;
}

.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

.vote-list {
  padding-top: 10rpx;
}

.vote-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.vote-item:last-child {
  border-bottom: none;
}

.vote-title {
  font-size: 30rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.vote-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.time {
  font-size: 24rpx;
  color: #999;
}

.status {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
}

.status.active {
  background: #ecfdf5;
  color: #059669;
}

.status.ended {
  background: #fef3c7;
  color: #d97706;
}

.setting-list {
  padding-top: 10rpx;
}

.setting-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.setting-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.arrow {
  font-size: 28rpx;
  color: #ddd;
}