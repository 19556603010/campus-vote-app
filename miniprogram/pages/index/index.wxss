.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.header {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  padding: 60rpx 40rpx 80rpx;
  border-radius: 0 0 40rpx 40rpx;
}

.title-section {
  margin-bottom: 20rpx;
}

.user-login, .user-info {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.login-btn {
  background: rgba(255, 255, 255, 0.2);
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  color: white;
  font-size: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.3);
}

.user-info {
  gap: 16rpx;
}

.user-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
}

.user-name {
  color: white;
  font-size: 28rpx;
  font-weight: 500;
}

.main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  display: block;
}

.sub-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stats {
  display: flex;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 20rpx;
  padding: 30rpx 40rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: white;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.stat-divider {
  width: 1rpx;
  background: rgba(255, 255, 255, 0.3);
}

.filter-bar {
  display: flex;
  margin: -40rpx 20rpx 20rpx;
  background: white;
  border-radius: 20rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  color: #999;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.filter-item.active {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
}

.vote-list {
  padding: 20rpx;
}

.vote-card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.vote-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.avatar-text {
  color: white;
  font-size: 32rpx;
  font-weight: 600;
}

.creator-info {
  flex: 1;
}

.creator-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  display: block;
}

.create-time {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.status-tag {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.status-tag.active {
  background: #ecfdf5;
  color: #059669;
}

.status-tag.ended {
  background: #fef3c7;
  color: #d97706;
}

.vote-content {
  margin-bottom: 20rpx;
}

.vote-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}

.vote-desc {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.vote-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.vote-stats {
  display: flex;
  gap: 30rpx;
}

.stat {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #999;
}

.icon {
  margin-right: 8rpx;
}

.arrow {
  font-size: 32rpx;
  color: #ddd;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #999;
}

.vote-main {
  padding: 30rpx;
}

.vote-actions {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 30rpx 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.action-btn {
  padding: 12rpx 32rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
}

.delete-btn {
  background: #fef2f2;
  color: #ef4444;
}

.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.loading-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.loading-state text:last-child {
  font-size: 28rpx;
  color: #999;
}
