.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.form-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 40rpx;
  text-align: center;
}

.form-item {
  margin-bottom: 36rpx;
}

.label {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 16rpx;
}

.label-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.upload-area {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f8f8f8;
  border: 2rpx dashed #ddd;
}

.upload-image {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999;
  font-size: 28rpx;
}

.upload-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.upload-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

.hint {
  font-size: 24rpx;
  color: #999;
  margin-left: 16rpx;
}

.input {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}

.input:focus {
  border-color: #7c3aed;
  background: white;
}

.textarea {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  min-height: 160rpx;
  border: 2rpx solid transparent;
  width: 100%;
  box-sizing: border-box;
}

.textarea:focus {
  border-color: #7c3aed;
  background: white;
}

.options-list {
  margin-bottom: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 16rpx;
}

.option-index {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.option-input {
  flex: 1;
  font-size: 28rpx;
  background: transparent;
}

.option-delete {
  width: 48rpx;
  height: 48rpx;
  background: #fef2f2;
  color: #ef4444;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
}

.add-option {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  color: #7c3aed;
  font-size: 28rpx;
}

.add-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
  font-weight: 600;
}

.radio-group {
  display: flex;
  gap: 30rpx;
}

.radio-item {
  flex: 1;
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
}

.radio-item.active {
  background: #f3f0ff;
  border-color: #7c3aed;
}

.radio-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid #ddd;
  margin-right: 16rpx;
  position: relative;
}

.radio-item.active .radio-circle {
  border-color: #7c3aed;
}

.radio-item.active .radio-circle::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 18rpx;
  height: 18rpx;
  background: #7c3aed;
  border-radius: 50%;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-arrow {
  color: #999;
  font-size: 24rpx;
}

.switch-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.submit-btn {
  background: linear-gradient(135deg, #7c3aed 0%, #9333ea 100%);
  color: white;
  border-radius: 48rpx;
  padding: 28rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.3);
}
